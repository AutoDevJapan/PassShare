{
  "name": "passshare-desktop",
  "version": "1.0.0",
  "description": "PassShare Desktop - Secure Password Manager",
  "main": "dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/AutoDevJapan/PassShare.git"
  },
  "author": {
    "name": "BM1314",
    "email": "info@bm1314.co.jp"
  },
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:main\" \"pnpm run dev:preload\" \"pnpm run dev:native-host\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:native-host": "tsc -p tsconfig.native-host.json --watch",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer && pnpm run build:native-host",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:native-host": "tsc -p tsconfig.native-host.json",
    "build:renderer": "node -e \"const fs=require('fs');fs.mkdirSync('dist/renderer',{recursive:true});fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html');\"",
    "start": "pnpm run build && electron .",
    "start:only": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "check-types": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.native-host.json"
  },
  "dependencies": {
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "net.bm1314.passshare",
    "productName": "PassShare",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/native-host",
        "to": "native-host",
        "filter": ["**/*"]
      },
      {
        "from": "native-host-manifests",
        "to": "native-host-manifests",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  }
}
