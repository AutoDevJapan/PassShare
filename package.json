{
  "name": "passshare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "setup": "pnpm install",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:frontend": "pnpm -C frontend build",
    "dev": "pnpm -C frontend dev",
    "dev:be": "cd backend && uv run uvicorn app.main:app --reload --port 8000",
    "test": "pnpm -r test",
    "test:py": "cd packages/passshare-python && uv run pytest -v",
    "test:ts": "pnpm -C packages/passshare-ts test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "check-types": "pnpm -C frontend check-types && pnpm -C packages/passshare-ts tsc --noEmit",
    "quality-gate": "node scripts/quality-gate.mjs",
    "qg": "node scripts/quality-gate.mjs",
    "preflight": "node scripts/preflight.mjs",
    "start": "pnpm -C desktop start",
    "start:backend": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron"]
  }
}
