{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PassShare",
  "version": "0.1.0",
  "identifier": "com.passshare.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PassShare",
        "width": 960,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NDc3MTVFQjFGMjQzMEUKUldRT1EvS3hYbkZITlZzVzUzOGxja3ZodGFsVzM4RnNsbmhtNXJ3dXV6dmlqdFlSMzR5cUxRd0oK",
      "endpoints": [
        "https://github.com/AutoDevJapan/PassShare/releases/latest/download/latest.json"
      ]
    }
  }
}
