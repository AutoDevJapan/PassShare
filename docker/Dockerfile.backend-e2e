FROM rust:1.86-bookworm

RUN apt-get update \
  && apt-get install -y curl ca-certificates \
  && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y nodejs \
  && corepack enable \
  && corepack prepare pnpm@10.11.0 --activate \
  && rm -rf /var/lib/apt/lists/*

# Pre-build op-cli in the image so runtime does not compile on every CI run.
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY apps/ ./apps/
RUN cargo build -p op-cli --release \
  && install -m 755 target/release/op /usr/local/bin/op

WORKDIR /app
