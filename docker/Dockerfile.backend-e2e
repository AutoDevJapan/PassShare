FROM rust:1.86-bookworm

RUN apt-get update \
  && apt-get install -y curl ca-certificates \
  && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y nodejs \
  && corepack enable \
  && corepack prepare pnpm@10.11.0 --activate \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
