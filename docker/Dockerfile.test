FROM rust:1.86-bookworm

WORKDIR /app

# Cache dependencies
COPY Cargo.toml Cargo.lock* ./
COPY crates/passshare-core/Cargo.toml crates/passshare-core/Cargo.toml
RUN mkdir -p crates/passshare-core/src && echo "fn main(){}" > crates/passshare-core/src/lib.rs
RUN cargo fetch -p passshare-core 2>/dev/null || true

COPY . .

CMD ["cargo", "test", "-p", "passshare-core", "-p", "passshare-connect", "-p", "op-cli", "--", "--nocapture"]
