# Railway: backend サービスの Variables で Postgres の DATABASE_URL を Variable Reference で追加する。
# 手入力の ${...} は展開されないため、Railway ダッシュボードから参照設定すること。
DATABASE_URL=postgresql://passshare:passshare@localhost:5432/passshare
APP_ENV=local
PORT=8080
# Allowed browser origin for /api/auth cookie sessions (CORS credentials)
WEB_ORIGIN=http://localhost:5173
# 1Password Connect compatible bearer token (local/dev/stg fallback for /v1/*)
OP_CONNECT_TOKEN=change-me-in-production
