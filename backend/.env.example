# Railway: backend サービスの Variables で Postgres の DATABASE_URL を Variable Reference で追加する。
# 手入力の ${...} は展開されないため、Railway ダッシュボードから参照設定すること。
DATABASE_URL=postgresql://passshare:passshare@localhost:5432/passshare
APP_ENV=local
PORT=8080
# Allowed browser origin for /api/auth cookie sessions (CORS credentials)
# local default: http://localhost:5173
# prd/stg: prod is served via the custom domain https://pass-share.bm1314.net — set that here.
#   Additionally, project-bound Vercel origins (pass-share-frontend.vercel.app and
#   pass-share-frontend-git-* previews) are always trusted for CORS via the hostname pattern.
#   The bare pass-share-frontend.vercel.app alias currently 404s (prod uses the custom domain).
WEB_ORIGIN=http://localhost:5173
# Vercel scope (team/user) slug for the deploying account, e.g. masashi-matsumotos-projects-c5830f3d.
# Set this on the shared preview backend so long branch names whose preview URL Vercel truncates
# (e.g. pass-share-fron-git-<hash>-<slug>.vercel.app) are still trusted. The slug suffix belongs to
# our Vercel scope, so this does NOT re-open the #315 `*.vercel.app` boundary. Leave unset for prd.
VERCEL_TEAM_SLUG=
# 1Password Connect compatible bearer token (local/dev/stg fallback for /v1/*)
OP_CONNECT_TOKEN=change-me-in-production
